# =========================================================================
# LegentArena — environment template
# Copy to `.env` for your OWN backend. NONE of these belong in front-end code.
#
# SECURITY: Only a Razorpay *public* key id (rzp_live_/rzp_test_) is safe in
# the browser (see assets/js/config.js -> RAZORPAY.keyId). Everything below is
# SECRET and must live only on a server you control.
# =========================================================================

# --- Razorpay (server-side only) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx        # public id (also set in config.js)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret   # SECRET — server only
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret     # SECRET — verify webhook signatures
RAZORPAY_WEBHOOK_URL=https://your-api.example.com/razorpay/webhook

# --- Supabase (optional backend) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_anon_key     # safe for client
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key # SECRET — server only, NEVER ship
